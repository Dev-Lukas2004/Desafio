{
  "name": "encurtador-de-links",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none test/*.test.ts"
  },
  "dependencies": { "express": "^5.1.0" },
  "devDependencies": { "@types/express": "^5.0.0", "@types/node": "^24.0.0", "typescript": "^5.9.0" }
}
